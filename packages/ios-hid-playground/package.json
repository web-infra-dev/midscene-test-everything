{
  "name": "@midscene/ios-hid-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "bin": {
    "midscene-ios-hid-playground": "dist/cli.js"
  },
  "scripts": {
    "build": "rslib build && rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.tests.json",
    "start": "node dist/cli.js",
    "test": "rstest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@midscene/ios-hid": "workspace:*",
    "@midscene/playground": "1.17.5",
    "@midscene/core": "1.17.5",
    "@midscene/robotics-vision": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@midscene/arm-kit-playground": "workspace:*",
    "antd": "^5.21.6",
    "@midscene/arm-calibration-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@rslib/core": "^0.18.3",
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-react": "^1.4.1",
    "@rsbuild/plugin-less": "^1.5.0",
    "less": "^4.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@rsbuild/plugin-node-polyfill": "1.4.2",
    "@rstest/core": "0.12.0"
  }
}
