{
  "name": "@midscene/ios-hid-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "public"],
  "bin": {
    "midscene-ios-hid-playground": "dist/cli.js"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.tests.json",
    "start": "node dist/cli.js",
    "test": "rstest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@midscene/ios-hid": "workspace:*",
    "@midscene/playground": "1.17.5",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@rslib/core": "^0.18.3",
    "@rstest/core": "0.12.0",
    "@types/express": "^4.17.0"
  }
}
