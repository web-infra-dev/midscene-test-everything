{
  "name": "@midscene/universal-device",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/midscene-test-everything.git",
    "directory": "packages/universal-device"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "bin": {
    "universal-device": "./dist/cli.js"
  },
  "scripts": {
    "cli": "node dist/cli.js",
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test tests/*.test.mjs && rstest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "dependencies": {
    "@midscene/core": "1.17.5",
    "@midscene/shared": "1.17.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "13.1.0",
    "swagger-ui-dist": "^5.32.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.3",
    "@rstest/core": "0.12.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
