{
  "name": "@midscene/arm-calibration-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.less": "./src/styles.less",
    "./standalone": "./dist/index.html",
    "./styles.css": "./lib/styles.css",
    "./model-config": {
      "types": "./lib/components/ModelConfigModal.d.ts",
      "import": "./lib/components/ModelConfigModal.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm build:lib && rsbuild build",
    "build:lib": "rslib build",
    "prepack": "pnpm build",
    "test": "rstest run"
  },
  "dependencies": {
    "@midscene/robotics-shared": "workspace:*",
    "@arco-design/web-react": "2.66.18",
    "antd": "^5.21.6",
    "zustand": "^5.0.0",
    "lucide-react": "0.553.0",
    "@midscene/robotics-vision": "workspace:*",
    "@midscene/core": "1.17.5"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-less": "^1.5.0",
    "@rsbuild/plugin-react": "^1.4.1",
    "@rslib/core": "^0.18.3",
    "@rstest/core": "0.12.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "less": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.3"
  },
  "files": ["lib", "dist", "src/styles.less"],
  "sideEffects": ["**/*.css", "**/*.less"]
}
