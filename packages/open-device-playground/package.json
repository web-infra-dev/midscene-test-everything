{
  "name": "@midscene/open-device-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "bin": {
    "open-device-playground": "dist/cli.js"
  },
  "scripts": {
    "build": "rslib build && rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.ui.json && tsc --noEmit -p tsconfig.tests.json",
    "start": "node dist/cli.js",
    "test": "rstest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@midscene/preview-controls": "workspace:*",
    "@midscene/open-device": "workspace:*",
    "@midscene/playground": "1.17.5",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-react": "^1.4.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "antd": "^5.21.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@rslib/core": "^0.18.3",
    "@rstest/core": "0.12.0",
    "@types/express": "^4.17.0"
  }
}
