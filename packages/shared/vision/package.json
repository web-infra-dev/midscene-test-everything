{
  "name": "@midscene/robotics-vision",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/midscene-test-everything.git",
    "directory": "packages/shared/vision"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "native", "assets/phone"],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "rstest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./camera/*": {
      "types": "./dist/camera/*.d.ts",
      "import": "./dist/camera/*.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "import": "./dist/setup/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./phone/*": {
      "types": "./dist/phone/*.d.ts",
      "import": "./dist/phone/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    }
  },
  "dependencies": {
    "@midscene/robotics-shared": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "sharp": "^0.34.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "js-aruco2": "2.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@rslib/core": "^0.18.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@rsbuild/plugin-react": "^1.4.1",
    "@types/ws": "8.18.2",
    "@rstest/core": "0.12.0"
  }
}
