{
  "name": "@midscene/robotics-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@rslib/core": "^0.18.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./kernel/contracts": {
      "types": "./dist/kernel/contracts.d.ts",
      "import": "./dist/kernel/contracts.js"
    },
    "./assisted-contracts": {
      "types": "./dist/assisted-contracts.d.ts",
      "import": "./dist/assisted-contracts.js"
    },
    "./setup-contracts": {
      "types": "./dist/setup-contracts.d.ts",
      "import": "./dist/setup-contracts.js"
    },
    "./camera/vision-geometry": {
      "types": "./dist/camera/vision-geometry.d.ts",
      "import": "./dist/camera/vision-geometry.js"
    },
    "./camera/errors": {
      "types": "./dist/camera/errors.d.ts",
      "import": "./dist/camera/errors.js"
    },
    "./camera/vision-types": {
      "types": "./dist/camera/vision-types.d.ts",
      "import": "./dist/camera/vision-types.js"
    },
    "./camera/profile": {
      "types": "./dist/camera/profile.d.ts",
      "import": "./dist/camera/profile.js"
    },
    "./marker-contracts": {
      "types": "./dist/marker-contracts.d.ts",
      "import": "./dist/marker-contracts.js"
    }
  }
}
