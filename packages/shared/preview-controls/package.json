{
  "name": "@midscene/preview-controls",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/midscene-test-everything.git",
    "directory": "packages/shared/preview-controls"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
