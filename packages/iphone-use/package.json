{
  "name": "@midscene/iphone-use",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "native"],
  "bin": {
    "iphone-use": "dist/launcher.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "node --test tests/*.test.mjs && rstest run",
    "start": "node dist/commands.js"
  },
  "dependencies": {
    "@midscene/open-device": "workspace:*",
    "@midscene/robotics-vision": "workspace:*",
    "antd": "^5.21.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "express": "4.22.3",
    "commander": "13.1.0",
    "react-resizable-panels": "2.0.22",
    "@midscene/core": "1.17.5",
    "@midscene/shared": "1.17.5",
    "@techstark/opencv-js": "5.0.0-release.1",
    "pacote": "^21",
    "sharp": "^0.34.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pacote": "11.1.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-react": "^1.4.1",
    "@rsbuild/plugin-less": "^1.5.0",
    "less": "^4.2.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@rsbuild/plugin-node-polyfill": "1.4.2",
    "@types/express": "^4.17.0",
    "@rstest/core": "0.12.0"
  }
}
