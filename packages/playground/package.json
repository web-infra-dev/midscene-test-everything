{
  "name": "@midscene/arm-kit-playground",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && rsbuild build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit",
    "test": "rstest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@midscene/robotics-shared": "workspace:*",
    "@ant-design/icons": "^5.3.1",
    "@midscene/arm-calibration-ui": "workspace:*",
    "@midscene/arm-kit": "workspace:*",
    "@midscene/core": "1.17.5",
    "@midscene/playground": "1.17.5",
    "@midscene/shared": "1.17.5",
    "@midscene/web": "1.17.5",
    "antd": "^5.21.6",
    "dayjs": "^1.11.11",
    "lucide-react": "0.553.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.0",
    "react-resizable-panels": "2.0.22",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.0",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.15",
    "@rsbuild/plugin-less": "^1.5.0",
    "@rsbuild/plugin-node-polyfill": "1.4.2",
    "@rsbuild/plugin-react": "^1.4.1",
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "less": "^4.2.0",
    "typescript": "^5.8.3",
    "@rstest/core": "0.12.0",
    "@types/node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./ui": "./src/ui/ui.ts",
    "./session": {
      "types": "./dist/server/session.d.ts",
      "import": "./dist/server/session.js"
    },
    "./i18n": "./src/ui/i18n.ts",
    "./host": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./shell": "./src/ui/vendor/playground-app/PlaygroundApp.tsx",
    "./shell/*": "./src/ui/vendor/playground-app/*"
  },
  "files": ["dist/server", "dist/ui", "src/ui"]
}
