# A Midscene Connect device URL. iOS AirLink: http://localhost:5801/devices/<id>.
# Robot arm: copy a screen URL from the arm manager under Robot settings → Midscene Connect.
MIDSCENE_CONNECT_URL=
# Get the token with pnpm ios-airlink token or in the arm manager.
MIDSCENE_CONNECT_TOKEN=

# Fill in the settings for your Midscene model provider.
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=
