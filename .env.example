# iOS AirLink defaults to port 5801. For a robot arm, use the backend URL printed by its manager.
MIDSCENE_UNIVERSAL_DEVICE_SERVICE_URL=http://localhost:5801
# Get the token with pnpm ios-airlink token or in the arm manager under Robot settings → Universal Device.
MIDSCENE_UNIVERSAL_DEVICE_SERVICE_TOKEN=
# Required when the service lists multiple devices.
MIDSCENE_UNIVERSAL_DEVICE_ID=

# Fill in the settings for your Midscene model provider.
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=
