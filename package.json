{
  "name": "midscene-arm-kit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "pnpm": ">=9.3.0",
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "biome check . --diagnostic-level=info --no-errors-on-unmatched --fix",
    "lint:check": "biome check . --diagnostic-level=info --no-errors-on-unmatched",
    "format": "pretty-quick --staged",
    "format:ci": "pretty-quick --since HEAD~1",
    "projects": "nx show projects",
    "dev": "pnpm --filter @midscene/arm-service dev",
    "dev:mock": "pnpm --filter @midscene/arm-service dev:mock",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint:staged": "lint-staged",
    "dev:playground": "pnpm --filter @midscene/open-device-playground start",
    "iphone-use:release": "node packages/iphone-use/scripts/package-release.mjs",
    "iphone-use": "pnpm --filter @midscene/iphone-use start"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "nx": "22.1.3",
    "prettier": "^3.6.2",
    "pretty-quick": "3.1.3",
    "tsx": "^4.20.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css}": "pnpm exec biome check --write --no-errors-on-unmatched",
    "*.{md,mdx,less,scss,yml,yaml}": "pnpm exec prettier --write"
  }
}
